{
  "name": "fde-developer-workbench",
  "productName": "灵栈 FDE",
  "description": "本地优先、可扩展的开发者桌面工作台",
  "author": "FDE Contributors",
  "version": "0.7.5",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:icons && node scripts/clean-build.mjs && vite build",
    "start": "vite preview",
    "desktop:dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env FDE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:dir:offline": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist --config.win.signExecutable=false",
    "desktop:pack": "npm run build && electron-builder",
    "desktop:pack:offline": "npm run build && electron-builder --config.electronDist=node_modules/electron/dist --config.win.signExecutable=false",
    "desktop:pack:offline:signed": "node scripts/require-windows-signing.mjs && npm run build && electron-builder --config.electronDist=node_modules/electron/dist --x64",
    "desktop:publish": "npm run build && electron-builder --publish always",
    "desktop:smoke": "electron . --smoke-test",
    "desktop:skills-smoke": "electron . --skills-smoke-test",
    "release:verify": "node scripts/verify-release.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/crypto-js": "^4.2.2",
    "cronstrue": "^3.24.0",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "0.45.2",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "marked": "^18.0.7",
    "next": "16.3.4",
    "opencc-js": "^1.4.1",
    "papaparse": "^5.5.4",
    "pinyin-pro": "^3.28.1",
    "prettier": "^3.9.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "drizzle-kit": "0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wait-on": "^9.1.0",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "dev.fde.workbench",
    "productName": "灵栈 FDE",
    "publish": {
      "provider": "github",
      "owner": "microsnow",
      "repo": "lingzhan-fde",
      "releaseType": "release"
    },
    "fileAssociations": [
      { "ext": ["txt", "md", "properties"], "name": "lingstack-fde-text", "description": "使用灵栈 FDE 打开文本文件", "role": "Editor" },
      { "ext": "json", "name": "lingstack-fde-json", "description": "使用灵栈 FDE 打开 JSON 文件", "mimeType": "application/json", "role": "Editor" },
      { "ext": "csv", "name": "lingstack-fde-csv", "description": "使用灵栈 FDE 打开 CSV 文件", "mimeType": "text/csv", "role": "Editor" },
      { "ext": "xml", "name": "lingstack-fde-xml", "description": "使用灵栈 FDE 打开 XML 文件", "mimeType": "application/xml", "role": "Editor" },
      { "ext": ["yaml", "yml"], "name": "lingstack-fde-yaml", "description": "使用灵栈 FDE 打开 YAML 文件", "mimeType": "application/yaml", "role": "Editor" },
      { "ext": ["html", "css", "js"], "name": "lingstack-fde-web", "description": "使用灵栈 FDE 打开 Web 文件", "mimeType": "text/plain", "role": "Editor" }
    ],
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/favicon.svg",
      "public/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "灵栈 FDE",
        "schemes": [
          "fde"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": ["AppImage", "deb"],
      "mimeTypes": ["text/plain", "text/markdown", "text/csv", "application/json", "application/xml", "application/yaml"]
    },
    "nsis": {
      "perMachine": true,
      "artifactName": "LingStack-FDE-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "LingStack-FDE-Portable-${version}-${arch}.${ext}"
    }
  },
  "type": "module"
}
